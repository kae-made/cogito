<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.CodeDom" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="KAE.CMTools.Core" #>
<#@ import namespace="KAE.CMTools.Core.DataType" #>
<#@ import namespace="KAE.CMTools.Generator.Core" #>

# This schema is generated by DomainSchemaGenerator
$schema: "https://json-schema.org/draft/2020-12/schema"
$title: "<#= this.domain.Name #>"
type: object
required: [fos]
properties:
  fos:
    type: object
    required: [fosId, domain, date, instances]
    properties:
      fosId:
        type: string
        format: uuid
      domain:
        type: string
      date:
        type: string
        pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
      instances:
        type: array
        items:
          type: object
          required: [instance, properties]
          properties:
            instance:
              type: string
              format: uuid
            properties:
              oneOf:
<#
    foreach (var keyLett in this.domain.ConceptualClasses.Keys)
    {
#>
                - $ref: "#/$defs/<#= keyLett #>"
<#
    }
#>

$defs:
<#
    foreach (var keyLett in this.domain.ConceptualClasses.Keys)
    {
        var cclass = this.domain.ConceptualClasses[keyLett];
        string name = cclass.Name;
        string number = cclass.Number;

        string propertyNameList = this.GetPropertyNameList(cclass);
#>
  <#= keyLett #>:
    type: object
    required: [cclass, <#= propertyNameList #>]
    properties:
      cclass:
        const: <#= keyLett #>
<#
        foreach (var propName in cclass.Properties.Keys)
        {
            var property = cclass.Properties[propName];
            if (!property.IsMethematical)
            {
                bool isDenote = property.IsDenote;
                string grammar = property.Grammar;
                var dataType = property.BaseDataType;
                string dataTypeName = dataType.Name;
                string format = "";
                if (dataType is PrimitiveDataType)
                {
                    (dataTypeName, format) = YamlDataTypeTranslator.ToYamlTypeName(((PrimitiveDataType)dataType).Kind);
                    if (property.IsNullable || property.IsParticipantProperty())
                    {
                        dataTypeName = $"[{dataTypeName}, \"null\"]";
                    }
                }
                string dataTypeComment = "";
                if (property.DataType.Name == DataType.DataTypeKind.UNIQUE_ID.ToString()
                    || property.DataType.Name == DataType.DataTypeKind.OTHER.ToString()
                            || property.DataType.Name == DataType.DataTypeKind.REFERENCE.ToString()
                            || property.DataType.Name==DataType.DataTypeKind.UNKNOWN.ToString())
                {
                    dataTypeComment = $"# {property.DataType.Name}";
                }
#>
      <#= propName #>:
        type: <#= dataTypeName #>
<#
                if (!string.IsNullOrEmpty(format))
                {
#>
        format: <#= format #>
<#
                }
                if (!string.IsNullOrEmpty(dataTypeComment))
                {
#>
        <#= dataTypeComment #>
<#
                }
#>
<#
                if (!string.IsNullOrEmpty(grammar))
                {
#>
        pattern: '<#= grammar #>'
<#
                }
            }
        }
#>
    additionalProperties: false
<#
    }
#>
